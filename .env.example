# Arc Network Environment ('mainnet' or 'testnet')
NEXT_PUBLIC_ARC_NETWORK=mainnet

# Optional Custom RPC URL override (defaults to https://rpc.mainnet.arc.io)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io

# WalletConnect / ConnectKit Project ID (optional, default fallback provided)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
